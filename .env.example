# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# LLM provider
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override model used for requirement extraction / direct scoring
# OPENAI_MODEL=gpt-4o

# Optional: path to disk cache directory (default: ./cache)
# CACHE_DIR=./cache
